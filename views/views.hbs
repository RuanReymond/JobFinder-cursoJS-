<main id="job-view-container" class="container">
    <a class="back-link" href="/">&larr; Voltar</a>

    <article class="job-detail">
        <header class="job-detail-header">
            <img class="job-detail-logo" src="/img/company.svg" alt="Logo da empresa">
            <h1 class="job-detail-title">{{job.dataValues.title}}</h1>
            <p class="job-detail-company">{{job.dataValues.company}}</p>
        </header>

        <section class="job-section">
            <h2 class="job-section-title">Quem eles estão buscando</h2>
            <p class="job-desc">{{job.dataValues.description}}</p>
        </section>

        <section class="job-section">
            <div class="job-salary-box">
                <strong>O salário informado é de:</strong>
                <span>R${{job.dataValues.salary}}</span>
            </div>
        </section>

        <section class="job-apply">
            Para trabalhar na empresa <span class="highlight">{{job.dataValues.company}}</span>
            envie um e-mail para <a href="mailto:{{job.dataValues.email}}">{{job.dataValues.email}}</a>
            com seu currículo anexado.
            <div>
                <a class="btn btn-primary" href="mailto:{{job.dataValues.email}}">Enviar currículo</a>
            </div>
        </section>
    </article>
</main>
