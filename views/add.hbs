    <div id="add-form-container" class="container">
        <div class="row">
            <div class="col-md-12">
                <h1 class="text-center">Dilvulgue a vaga preenchendo o formulario</h1>
            </div>
            <div id="form-box" class="col-md-12">
                <h2>preencha os dados da melhor forma possivel para encontrar mais rapido seu dev</h2>
                <form action="/jobs/add" method="POST">
                    <div class="form-group">
                        <label for="title">Titulo da vaga</label>
                        <input type="text" class="form-control" id="title" name="title" placeholder="Digite o titulo da vaga" required>
                        <small id="titleHelp" class="form-text text-muted">O titulo da vaga deve ser descritivo e atrativo.</small>
                    </div>
                    <div class="form-group">
                        <label for="description">Descrição da vaga</label>
                        <input type="text" class="form-control" id="description" name="description" placeholder="Digite a descrição da vaga" required>
                        <small id="descriptionHelp" class="form-text text-muted">A descrição deve detalhar as responsabilidades e requisitos da vaga.</small>
                    </div>
                    <div class="form-group">
                        <label for="company">Empresa Contratante</label>
                        <input type="text" class="form-control" id="company" name="company" placeholder="Digite o nome da empresa" required>
                        <small id="companyHelp" class="form-text text-muted">O nome da empresa deve ser completo e correto.</small>
                    </div>
                    <div class="form-group">
                        <label for="email">Email de contato</label>
                        <input type="email" class="form-control" id="email" name="email" placeholder="Digite o email de contato" required>
                        <small id="emailHelp" class="form-text text-muted">O email deve ser válido e ativo.</small>
                    </div>
                    <div class="form-group">
                        <label for="salary">Salário</label>
                        <input type="text" class="form-control" id="salary" name="salary" placeholder="Digite o salário da vaga" required>
                        <small id="salaryHelp" class="form-text text-muted">O salário deve ser realista e competitivo.</small>
                    </div>
                    <input type="hidden" name="new_job" value="1">
                    <button type="submit" class="btn btn-primary">Enviar</button>
                </form>
            </div>
        </div>
    </div>
