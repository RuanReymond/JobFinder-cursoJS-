<section id="top-container">
    <h1 id="main-title">Encontre o emprego ideal para você</h1>
    <p id="main-subtitle">Explore oportunidades de trabalho em diversas áreas e encontre a vaga perfeita para sua carreira.</p>

    <form id="search-form" action="/" method="GET" role="search">
        <input type="text" class="form-control search-input" id="job" name="job" placeholder="Digite o cargo ou empresa" aria-label="Buscar vagas">
        <button type="submit" class="btn btn-primary search-button">Buscar</button>
    </form>
</section>

<main>
    <div id="jobs-container" class="container">
        {{#if search}}
        <h2 id="job-list-title">Resultados da busca por: "{{search}}"</h2>
        {{else}}
        <h2 id="job-list-title">Vagas em destaque</h2>
        {{/if}}

        <ul id="jobs-list" class="list-group">
            {{#each jobs}}
            <li class="job-card {{#if dataValues.new_job}}new-job{{/if}}">
                <img class="job-logo" src="/img/company.svg" alt="Logo da empresa">

                <div class="job-info">
                    <p class="job-company">{{dataValues.company}}</p>
                    <h2 class="job-title">{{#if dataValues.title}}{{dataValues.title}}{{else}}Título não informado{{/if}}</h2>
                    <p class="job-salary">{{dataValues.salary}}</p>
                </div>

                <div class="job-actions">
                    {{#if dataValues.new_job}}<span class="new-job-label">Nova</span>{{/if}}
                    <a class="btn btn-primary" href="/jobs/view/{{dataValues.id}}">Ver detalhes</a>
                </div>
            </li>
            {{else}}
            <li class="jobs-empty">Nenhuma vaga encontrada.</li>
            {{/each}}
        </ul>
    </div>
</main>
